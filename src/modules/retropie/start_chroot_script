# Definition of functions for coloring text in the terminal
echo_green() {
    echo -e "\e[32m$1\e[0m" # Green
}

echo_red() {
    echo -e "\e[31m$1\e[0m" # Red (not used in this script but defined for consistency)
}

# Announcing the start of the RetroPie installation
echo_green "Installing RetroPie ..."

## Update packages (uncomment if necessary)
#apt-get update

## Ensure 'git' is installed (uncomment and implement check_install_pkgs if necessary)
#check_install_pkgs git

## Step 1: Move to the user's Home directory as the Working Directory
pushd "/home/${BASE_USER}" &> /dev/null || exit 1

## Step 2: Clone the Retropie repository
echo "Cloning the Retropie-smartpi repository..."
if git clone https://github.com/Yumi-Lab/Retropie-smartpi.git; then
    echo "Repository cloned successfully."
else
    echo "Failed to clone repository."
    #exit 1
fi

## Step 3: Move to the Retropie directory as the working directory
pushd "/home/${BASE_USER}/Retropie-smartpi" &> /dev/null || exit 1

## Step 4: Launch the Retropie installation routine
echo_green "Launch RetroPie install routine ..."
sudo ./install.sh
cd ..

## Step 5: Leave the Retropie directory
popd &> /dev/null || exit 1

## Step 6: Clean up the packages.lst file (uncomment if necessary)
#rm -f "${SR_BUILD_PACKAGE_FILE}"

## End of installation
echo_green "Installing RetroPie ... DONE!"

# Vérifier si le répertoire est utilisé
lsof +D /home/runner/work/YumiOS-retropie-test/YumiOS-retropie-test/repository/src/workspace/mount/dev

# Démonter les sous-systèmes de fichiers
sudo umount /home/runner/work/YumiOS-retropie-test/YumiOS-retropie-test/repository/src/workspace/mount/dev/pts
sudo umount /home/runner/work/YumiOS-retropie-test/YumiOS-retropie-test/repository/src/workspace/mount/proc
sudo umount /home/runner/work/YumiOS-retropie-test/YumiOS-retropie-test/repository/src/workspace/mount/var/cache/apt

# Finalement, démonter le système de fichiers principal
sudo umount /home/runner/work/YumiOS-retropie-test/YumiOS-retropie-test/repository/src/workspace/mount/dev
